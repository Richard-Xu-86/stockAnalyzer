# --- SnapTrade OAuth app (dashboard → OAuth Apps). Keep the secret server-side only.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Must exactly match a registered redirect URI (scheme, host, port, path).
SNAPTRADE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
SNAPTRADE_ISSUER=https://api.snaptrade.com
SNAPTRADE_API_BASE=https://api.snaptrade.com

# --- Database: Neon *pooled* connection string (host contains "-pooler").
DATABASE_URL=

# --- Secrets. Generate with: npm run keygen
# Session cookie encryption (32+ chars).
SESSION_SECRET=
# Token encryption keyring: comma-separated id:base64key pairs (32-byte keys); TOKEN_KEY_ID picks the key for new writes.
TOKEN_KEYS=
TOKEN_KEY_ID=
# Vercel sends this as a Bearer token on cron requests.
CRON_SECRET=

# --- Bank of Canada Valet API
BOC_API_BASE=https://www.bankofcanada.ca/valet
