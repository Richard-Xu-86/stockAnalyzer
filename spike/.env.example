# Test OAuth app from the SnapTrade dashboard (OAuth Apps). The secret is shown once.
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
# Must match a registered redirect URI exactly, including port and path.
SNAPTRADE_REDIRECT_URI=http://127.0.0.1:3000/oauth/snaptrade/callback
SNAPTRADE_ISSUER=https://api.snaptrade.com
SNAPTRADE_API_BASE=https://api.snaptrade.com
# Label for this run's output folder, e.g. the Sandbox scenario you connected.
SPIKE_SCENARIO=self-directed
